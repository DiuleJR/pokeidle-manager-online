# URL do WebSocket do jogo (não consta na spec; preencha)
WS_URL=wss://CHANGE_ME
# Close codes tratados como "login externo" (ajuste após observar o servidor)
EXTERNAL_LOGIN_CLOSE_CODES=4001,4003,1008

# ---- Conta 1 (repita para ACC2..ACC4) ----
ACC1_NICK=
ACC1_TOKEN=
ACC1_DEVICE_ID=
# Deixe PROXY_HOST vazio para conectar sem proxy (ex: testes locais).
# Se as 4 contas vão usar o MESMO proxy, repita os mesmos valores nos
# blocos ACC2_PROXY_*/ACC3_PROXY_*/ACC4_PROXY_* — cada conta abre seu
# próprio túnel, mas todos apontam pro mesmo host:porta.
# Atenção: confirme se o plano do proxy permite múltiplas conexões
# simultâneas (alguns planos de IP dedicado só permitem 1 por vez; se
# for o caso, as 4 contas vão brigar entre si pra abrir o túnel).
ACC1_PROXY_SCHEME=socks5
ACC1_PROXY_HOST=
ACC1_PROXY_PORT=
ACC1_PROXY_USER=
ACC1_PROXY_PASS=

# Hunt a selecionar ao conectar (slug de welcome.hunts); vazio = mantém a atual
ACC1_HUNT_SLUG=

# Captura automática (ball.throw)
ACC1_AUTO_CATCH=true
# Ordem de preferência de ballId (1=Poké Ball, 2=Great Ball, 3=Super Ball, 4=Ultra Ball)
ACC1_BALL_PRIORITY=1,2,3,4

# Reposição automática de Potion (shop.buy kind=item)
ACC1_AUTO_POTION=true
# ID da Potion a repor (200 Small, 201 Great, 202 Ultra, 203 Hyper, 204 Ultimate, 70070 Golden).
# Vazio = tenta usar o heldItemId do Pokémon ativo como palpite (nem sempre correto).
ACC1_POTION_ID=
ACC1_POTION_RESTOCK_THRESHOLD=10
ACC1_POTION_RESTOCK_QTY=100

# ---- Telemetria (FastAPI: GET /api/telemetry, WS /ws/telemetry) ----
# 127.0.0.1 = só local. Em Docker/VPS use 0.0.0.0 E defina TELEMETRY_TOKEN.
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8080
# Se definido, exige ?token=... (WS) ou Authorization: Bearer ... (HTTP)
TELEMETRY_TOKEN=
TELEMETRY_INTERVAL_S=1
# Origens permitidas para o dashboard (CORS), separadas por vírgula
TELEMETRY_CORS_ORIGINS=

# Reposição da Ball equipada (shop.buy kind=ball): compra QTY quando o estoque ficar ABAIXO de THRESHOLD.
# Vazio em BALL_ID = usa as Balls configuradas na automação do jogo (automation.ballIds).
ACC1_AUTO_BALL_RESTOCK=true
ACC1_BALL_ID=
ACC1_BALL_RESTOCK_THRESHOLD=10
ACC1_BALL_RESTOCK_QTY=100

# ---- Discord ----
# Webhook para alertas (queda/volta, item raro, relatorio diario). Vazio = desligado.
DISCORD_WEBHOOK_URL=
# Hora local em que o dia vira e o relatorio sai (0-23) e fuso
DAILY_REPORT_HOUR=0
REPORT_TZ=America/Sao_Paulo
# URL publica do dashboard (sem / no final) — usada so para montar a URL do
# icone (thumbnail) do item raro no embed do Discord. Vazio = embed sem icone.
PUBLIC_URL=https://seu-dominio.exemplo
