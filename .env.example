# Configuração básica do servidor do painel. TODO o resto (contas, proxy, Discord,
# fuso etc.) é feito pelo painel, na aba "Configurações".

# Onde o painel escuta. 127.0.0.1 = só neste computador (recomendado).
# Em Docker use 0.0.0.0 (e então o login passa a ser exigido em tudo).
TELEMETRY_HOST=127.0.0.1
TELEMETRY_PORT=8080

# Chave de acesso para scripts e VPS (opcional). Se definida, ela também vale como senha do
# painel e como `Authorization: Bearer`. Se vazia, você cria a senha no primeiro acesso.
TELEMETRY_TOKEN=

# Pasta dos dados (banco com as contas e tokens). Padrão: ./data
# DATA_DIR=./data

# Origens permitidas para o dashboard em outro domínio (CORS), separadas por vírgula.
TELEMETRY_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Migração: se você já usava o formato antigo (ACC1_NICK, ACC1_TOKEN, ...),
# deixe essas variáveis aqui UMA vez: na 1ª execução elas são importadas para o
# banco, e depois o painel passa a mandar. Veja o README.
